# SQLite (recomendado para empezar — sin Docker). Tras copiar a `.env`, ejecuta:
#   npm run setup
DATABASE_URL="file:./dev.db"

# Postgres (opcional). Cambia `provider` en prisma/schema.prisma a
# `postgresql`, luego usa una URL como:
#   postgresql://postgres:postgres@localhost:5432/percys
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/percys"

NODE_ENV="development"

# Carpeta escaneada para cómics (CBZ / CBR / PDF / carpetas de imágenes).
LIBRARY_PATH="./data/library"

CACHE_DIR="./cache"

PORT=4000

LOG_LEVEL="info"

CORS_ORIGINS="*"

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600
RATE_LIMIT_UPLOAD_MAX=30

JSON_BODY_LIMIT="10mb"

PAGE_MEMORY_CACHE_ITEMS=60

# Secreto para JWT y tokens de propietario (mín. 32 caracteres). Obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
